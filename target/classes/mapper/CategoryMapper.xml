<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.forum.mapper.CategoryMapper">
    
    <resultMap id="BaseResultMap" type="com.example.forum.entity.Category">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <select id="findAll" resultMap="BaseResultMap">
        SELECT * FROM category ORDER BY create_time DESC
    </select>
    
    <select id="findById" resultMap="BaseResultMap" parameterType="java.lang.Long">
        SELECT * FROM category WHERE id = #{id}
    </select>
    
    <select id="findByName" resultMap="BaseResultMap" parameterType="java.lang.String">
        SELECT * FROM category WHERE name = #{name}
    </select>
    
    <insert id="insert" parameterType="com.example.forum.entity.Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (name, description, create_time, update_time)
        VALUES (#{name}, #{description}, #{createTime}, #{updateTime})
    </insert>
    
    <update id="update" parameterType="com.example.forum.entity.Category">
        UPDATE category 
        SET name = #{name}, description = #{description}, update_time = #{updateTime}
        WHERE id = #{id}
    </update>
    
    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM category WHERE id = #{id}
    </delete>
</mapper>